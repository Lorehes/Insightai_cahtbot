# ⚠ 이 파일은 두 파서가 읽습니다
#    - docker compose : dotenv 규칙
#    - Spring Boot    : Java properties 규칙 (spring.config.import)
#    둘 다 만족하려면 아래를 지킬 것
#
#    ✗ export KEY=값        → 키가 "export KEY"가 됨
#    ✗ KEY="값"             → 따옴표가 값에 포함됨
#    ✗ 값에 백슬래시(\)     → properties에서 이스케이프 문자로 먹힘
#    ✓ 경로는 슬래시(/)로   → Java는 Windows에서도 / 를 인식함
#    ✓ 값 안의 콜론(:)은 안전 (jdbc:postgresql://... 정상)

# ─────────────────────────────────────────────────────────────
# 환경변수 템플릿. 이 파일은 커밋한다. 비밀값을 적지 않는다.
# 사용법: cp .env.example .env  후 빈 값을 채운다.
# ─────────────────────────────────────────────────────────────

# ── LLM (OpenRouter, OpenAI 호환 API) ──

# OpenRouter API 키. https://openrouter.ai/keys 에서 발급한다. 커밋 금지.
OPENROUTER_API_KEY=

# OpenRouter 엔드포인트. 끝에 /v1 을 반드시 붙인다 — Spring AI 2.0은 공식 OpenAI Java SDK를
# 그대로 감싸므로 SDK가 뒤에 /chat/completions 만 붙인다. /v1 을 빼면 404 (D1 실측).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 채팅에 사용할 기본 모델 ID. app.models.items(application.yaml)에 등록된 5종 중
# 하나와 문자열이 정확히 일치해야 한다 — 그 외 값은 기동 시 fail-fast (chat:AC-21).
#   upstage/solar-pro4 | google/gemini-2.5-flash-lite | openai/gpt-5-mini |
#   google/gemini-2.5-flash | anthropic/claude-haiku-4.5
CHAT_MODEL_DEFAULT=upstage/solar-pro4

# 임베딩 모델. 1024차원이며 application.yaml 의 pgvector dimensions 와 일치해야 한다.
EMBEDDING_MODEL=baai/bge-m3

# 재순위(rerank) 모델. app.rerank.enabled=true 일 때만 사용된다.
RERANK_MODEL=cohere/rerank-v3.5

# ── DB (ParadeDB = PostgreSQL + pg_search + pgvector) ──

# docker compose 가 컨테이너 초기화 시 만드는 데이터베이스 이름.
DB_NAME=chatbot

# DB 부트스트랩 전용 슈퍼유저. compose 의 POSTGRES_USER/PASSWORD 에만 쓰인다.
# 앱·Flyway 는 이 계정을 쓰지 않는다 (review 2026-08-25 High-1 — 런타임 슈퍼유저 금지).
DB_USER=chatbot

# 위 부트스트랩 계정의 비밀번호. 값을 비워둔다 — 이 파일은 커밋 대상이라 실제 값을
# 적으면 그대로 커밋되고, 대부분의 개발자가 .env.example 을 .env 로 복사한 뒤 이미
# 채워진 값을 그대로 두고 쓰기 때문이다(review 2026-08-25 High-1). 아래 명령으로 직접
# 강한 무작위 값을 생성해 .env 에만 채운다: openssl rand -hex 24
# ⚠ 이 값을 바꾼 뒤에는 반드시 볼륨을 재생성해야 한다 — infra/init-db 스크립트는
#   "빈" 데이터 디렉터리에서 컨테이너 최초 기동 시 1회만 실행되므로, 이미 만들어진
#   볼륨을 재기동만 해서는 DB 안의 실제 비밀번호가 바뀌지 않는다.
#   docker compose down -v && docker compose up -d  (이 프로젝트 DB엔 실 데이터가 없어 안전)
DB_PASSWORD=

# 앱·Flyway 전용 비슈퍼유저 역할. infra/init-db/01-bootstrap-extensions-and-app-role.sh
# 가 컨테이너 최초 기동 시 만든다(CREATE ROLE ... NOSUPERUSER). application.yaml 의
# spring.datasource.username/password 가 이 값을 참조한다.
APP_DB_USER=chatbot_app

# 위 앱 역할의 비밀번호. 값을 비워둔다 — 위 DB_PASSWORD 와 같은 이유(review 2026-08-25
# High-1). 생성: openssl rand -hex 24
# ⚠ 이 값도 DB_PASSWORD 와 마찬가지로 볼륨 재생성이 필요하다 — init-db 스크립트가
#   CREATE ROLE ... PASSWORD 로 역할을 만드는 시점은 볼륨이 빈 상태일 때뿐이다.
APP_DB_PASSWORD=

# 앱이 접속할 JDBC URL. 앱은 IntelliJ에서 직접 실행하므로 호스트는 localhost 다.
DB_URL=jdbc:postgresql://localhost:5432/chatbot

# ── 문서 인제스천 (document-ingestion Spec) ──

# 업로드 원본 파일 저장 경로. 기본값 없음 — 필수. 반드시 절대 경로 + 슬래시(/)만 사용한다
# (위 파서 주의사항과 동일하게 백슬래시는 properties 이스케이프 문자로 먹힌다).
# 앱 실행 cwd가 backend/ 또는 프로젝트 루트로 갈릴 수 있어(위 config.import 주석 참고)
# 상대 경로는 쓰지 않는다.
# 드라이브 루트(C:/) 바로 아래는 금지 — C:\ 의 상속 ACL(Authenticated Users:(OI)(CI)(IO)(M))이
# 그대로 내려와 로컬 인증 계정 전체가 원본 문서와 RAG 코퍼스를 읽고 쓸 수 있게 된다(리뷰 지적).
# %LOCALAPPDATA%(보통 C:/Users/<사용자명>/AppData/Local) 하위처럼 사용자 프로필 안의,
# 상속 ACL이 좁은 경로를 쓴다. <사용자명>을 실제 로그인 계정으로 바꿔서 .env 에 채운다.
UPLOAD_DIR=C:/Users/<사용자명>/AppData/Local/insight-chat/uploads
