# ⚠ 이 파일은 두 파서가 읽습니다
#    - docker compose : dotenv 규칙
#    - Spring Boot    : Java properties 규칙 (spring.config.import)
#    둘 다 만족하려면 아래를 지킬 것
#
#    ✗ export KEY=값        → 키가 "export KEY"가 됨
#    ✗ KEY="값"             → 따옴표가 값에 포함됨
#    ✗ 값에 백슬래시(\)     → properties에서 이스케이프 문자로 먹힘
#    ✓ 경로는 슬래시(/)로   → Java는 Windows에서도 / 를 인식함
#    ✓ 값 안의 콜론(:)은 안전 (jdbc:postgresql://... 정상)

# ─────────────────────────────────────────────────────────────
# 환경변수 템플릿. 이 파일은 커밋한다. 비밀값을 적지 않는다.
# 사용법: cp .env.example .env  후 빈 값을 채운다.
# ─────────────────────────────────────────────────────────────

# ── LLM (OpenRouter, OpenAI 호환 API) ──

# OpenRouter API 키. https://openrouter.ai/keys 에서 발급한다. 커밋 금지.
OPENROUTER_API_KEY=

# OpenRouter 엔드포인트. 끝에 /v1 을 반드시 붙인다 — Spring AI 2.0은 공식 OpenAI Java SDK를
# 그대로 감싸므로 SDK가 뒤에 /chat/completions 만 붙인다. /v1 을 빼면 404 (D1 실측).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 채팅에 사용할 기본 모델 ID (예: anthropic/claude-sonnet-4.5).
CHAT_MODEL_DEFAULT=

# 임베딩 모델. 1024차원이며 application.yaml 의 pgvector dimensions 와 일치해야 한다.
EMBEDDING_MODEL=baai/bge-m3

# 재순위(rerank) 모델. app.rerank.enabled=true 일 때만 사용된다.
RERANK_MODEL=cohere/rerank-v3.5

# ── DB (ParadeDB = PostgreSQL + pg_search + pgvector) ──

# docker compose 가 컨테이너 초기화 시 만드는 데이터베이스 이름.
DB_NAME=chatbot

# DB 사용자. compose 의 POSTGRES_USER 와 앱의 spring.datasource.username 에 함께 쓰인다.
DB_USER=chatbot

# DB 비밀번호. 로컬 데모 기본값이며 운영에서는 반드시 교체한다.
DB_PASSWORD=chatbot

# 앱이 접속할 JDBC URL. 앱은 IntelliJ에서 직접 실행하므로 호스트는 localhost 다.
DB_URL=jdbc:postgresql://localhost:5432/chatbot
